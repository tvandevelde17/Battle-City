<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #2b2b2b;"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.JuegoTerminadoController">

    <children>
        <Label fx:id="tituloLabel" text="JUEGO TERMINADO" textFill="RED"
               layoutY="80.0" prefWidth="800.0" alignment="CENTER">
            <font>
                <Font name="Arial Bold" size="48.0" />
            </font>
        </Label>

        <Label fx:id="mensajeLabel" text="Mensaje del resultado" textFill="WHITE" wrapText="true"
               layoutY="180.0" prefWidth="800.0" alignment="CENTER">
            <font>
                <Font name="Arial" size="20.0" />
            </font>
        </Label>


        <Button fx:id="siguienteNivelButton" text="Siguiente Nivel"
                layoutY="300.0" prefWidth="200.0" prefHeight="40.0"
                layoutX="300.0" />


        <Button fx:id="salirButton" text="Salir del Juego"
                layoutY="420.0" prefWidth="200.0" prefHeight="40.0"
                layoutX="300.0" />
    </children>
</AnchorPane>