<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<AnchorPane id="VentanaMenu" fx:id="VentanaMenu"
            prefWidth="800.0" prefHeight="600.0"
            style="-fx-background-color: black;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.ControladorMenu">

    <!-- Título centrado -->
    <ImageView fx:id="TituloMenu" fitHeight="145.0" fitWidth="400.0"
               layoutX="200.0" layoutY="50.0" preserveRatio="true">
        <image>
            <Image url="@/YABC-Assets/sprites/menu/Titulo400x145.png"/>
        </image>
    </ImageView>

    <!-- Selector independiente -->
    <ImageView fx:id="MenuSelector" fitHeight="75.0" fitWidth="75.0"
               layoutX="362.5" layoutY="300.0" preserveRatio="true">
        <image>
            <Image url="@/YABC-Assets/sprites/menu/Selector 75x75.png"/>
        </image>
    </ImageView>

    <!-- VBox centrado horizontalmente para botones -->
    <VBox alignment="CENTER" spacing="40.0"
          layoutX="0.0" prefWidth="800.0" layoutY="250.0"
          fx:id="MenuVBox"> <!-- Agrega un id para referencia -->
        <children>
            <Label fx:id="UnJugador" text="1 JUGADOR"
                   style="-fx-text-fill: white; -fx-font-size: 40px;"
                   prefWidth="800.0" alignment="CENTER"/>
            <Label fx:id="DosJugadores" text="2 JUGADORES"
                   style="-fx-text-fill: white; -fx-font-size: 40px;"
                   prefWidth="800.0" alignment="CENTER"/>
        </children>
    </VBox>

</AnchorPane>