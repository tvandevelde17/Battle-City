<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="Ventana" fx:id="Ventana"
            maxHeight="600.0" maxWidth="800.0"
            minHeight="600.0" minWidth="800.0"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@../estilos/Ventana.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.ControladorVentana">

    <children>
        <AnchorPane id="Pantalla" fx:id="Pantalla"
                    maxHeight="600.0" maxWidth="800.0"
                    minHeight="600.0" minWidth="800.0"
                    prefHeight="600.0" prefWidth="800.0">
            <fx:include source="menu.fxml" fx:id="VentanaMenu"/>
            <fx:include source="juego.fxml" fx:id="VentanaJuego"/>
        </AnchorPane>
    </children>
</AnchorPane>